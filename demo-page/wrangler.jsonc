// Hosts the demo page on Cloudflare at https://hdfc-vs-demo.skillmine-hr-api.workers.dev
// Deploy from this folder with: npx wrangler deploy
// src/worker.js adds the tools for Perfox (/mcp) and Reset (/api/reset); everything else is the page (chat only).
// The full earlier version (Apply, People, Desk) is on the full-demo branch, live at https://hdfc-vs-full.skillmine-hr-api.workers.dev
{
  "name": "hdfc-vs-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "CLAIMS", "class_name": "ClaimsStore" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClaimsStore"] }
  ]
}
